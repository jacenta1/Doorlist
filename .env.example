# Doorlist runs with none of this set: demo mode, seeded data, no money moves.

# demo (default) or live
DOORLIST_MODE=demo
# Public URL of the app; ticket and poster QR codes point here.
DOORLIST_BASE_URL=http://localhost:8080
# Time zone event times are shown in (IANA name).
DOORLIST_TZ=UTC
PORT=8080

# ---- live mode only ----
NEAR_NETWORK=testnet
# NEAR_RPC_URL=https://rpc.testnet.fastnear.com
# Account the Doorlist contract is deployed to.
DOORLIST_CONTRACT=
# Relayer: submits door-signed check-ins and payout batches, and deposits USDC
# that arrived through 1Click. Use a dedicated account with a small balance.
DOORLIST_RELAYER_ACCOUNT=
DOORLIST_RELAYER_KEY=
# Signs host session cookies (32+ random characters).
DOORLIST_SECRET=
# Optional 1Click JWT (lower fee). https://partners.near-intents.org
ONECLICK_JWT=
# Set to 1 to request real deposit addresses (dry: false). Mainnet only: NEAR Intents has no testnet.
DOORLIST_LIVE_QUOTES=
