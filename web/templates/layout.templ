package templates

import "doorlist/internal/event"

templ Page(site Site, title string, desc string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
			<title>{ title }</title>
			<meta name="description" content={ desc }/>
			<meta name="theme-color" content="#141414"/>
			<link rel="icon" href="/static/icon.svg" type="image/svg+xml"/>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Anton&family=DM+Sans:ital,opsz,wght@0,9..40,400..700;1,9..40,400&display=swap"/>
			<link rel="stylesheet" href="/static/base.css"/>
			<link rel="stylesheet" href="/static/doorlist.css"/>
			<script src="/static/vendor/htmx.min.js" defer></script>
		</head>
		<body hx-boost="false">
			if site.Demo {
				<div class="demo-bar" role="note">
					<span class="dot" aria-hidden="true"></span>
					<span><b>Demo mode.</b> Seeded events, a simulated chain and DAO running the real contract logic, dry-run 1Click quotes. No money moves.</span>
				</div>
			}
			<header class="top">
				<a href="/" class="mark" aria-label="Doorlist home">DOORLIST</a>
				<nav aria-label="Main">
					<a href="/" aria-current?={ site.Path == "/" }>Events</a>
					<a href="/break">Break it</a>
					<a href="/kit">Host kit</a>
					if site.Host != "" {
						<a href="/host" class="pill">{ short(site.Host) }</a>
					} else {
						<a href="/host" class="pill">Host an event</a>
					}
				</nav>
			</header>
			<main id="main">
				{ children... }
			</main>
			<footer class="foot">
				<span>Doorlist · deposits held in a Sputnik DAO on NEAR · settled through NEAR Intents</span>
				<span>Ledger: { site.ChainName }</span>
			</footer>
		</body>
	</html>
}

templ Bare(site Site, title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
			<title>{ title }</title>
			<meta name="theme-color" content="#141414"/>
			<link rel="icon" href="/static/icon.svg" type="image/svg+xml"/>
			<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Anton&family=DM+Sans:opsz,wght@9..40,400..700&display=swap"/>
			<link rel="stylesheet" href="/static/base.css"/>
			<link rel="stylesheet" href="/static/doorlist.css"/>
			<script src="/static/vendor/htmx.min.js" defer></script>
		</head>
		<body class="bare">
			{ children... }
		</body>
	</html>
}

templ IconCal() {
	<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><rect x="3.5" y="5" width="17" height="15" rx="2.5"></rect><path d="M3.5 10h17M8 3v4M16 3v4"></path></svg>
}

templ IconPin() {
	<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-6.5-6.2-6.5-11.2a6.5 6.5 0 0 1 13 0C18.5 14.8 12 21 12 21z"></path><circle cx="12" cy="9.8" r="2.3"></circle></svg>
}

templ IconCheck() {
	<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>
}

templ IconArrow() {
	<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
}

templ Avatars(guests []*event.Guest, max int) {
	<ul class="faces" aria-label="Who is going">
		for i, g := range guests {
			if i < max {
				<li title={ g.Name }><span>{ event.Initials(g.Name) }</span></li>
			}
		}
		if len(guests) > max {
			<li class="more"><span>{ "+" + itoa(len(guests)-max) }</span></li>
		}
	</ul>
}
